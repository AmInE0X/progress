# Supabase Configuration
# Optional for local demo mode. The app works with fictional in-memory demo data without Supabase.
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never prefix this with NUXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
